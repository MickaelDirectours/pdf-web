<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <RollingFile  name="fileAppender" fileName="C:/sources/logs/jt.log" append="false" filePattern="jt-%i.log">
            <PatternLayout>
                <Pattern>%d{dd/MM/yyyy - HH:mm:ss} - [%p] : %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="fr.ngtravel" level="INFO"/>
        
        
        <Logger name="org.springframework.cache" level="INFO"/>
        <Logger name="org.springframework.security" level="WARN"/>
        <Logger name="org.springframework.context" level="WARN"/>
        <Logger name="io.awspring.cloud.sqs" level="WARN"/>
        
        
        <Root level="WARN">
            <AppenderRef ref="fileAppender"/>
        </Root>
    </Loggers>
</Configuration>